# ==========================================
# LinkedIn Job Automation - Environment Config
# (Copy this to .env and fill in your values)
# ==========================================

# 1. Google Gemini API (Rotating Multi-Key Support)
# Get free keys from https://aistudio.google.com/app/apikey
GOOGLE_API_KEYS=your_gemini_key_1,your_gemini_key_2,your_gemini_key_3
MODEL=gemini-2.5-flash

# 2. Alternative LLM Providers (Optional)
GROQ_API_KEY=
USE_GROQ=false

OPENROUTER_API_KEY=
USE_OPENROUTER=false

ANTHROPIC_API_KEY=
USE_ANTHROPIC=false

# 3. LinkedIn Account Credentials (Used for automatic login fallback)
LINKEDIN_EMAIL=your_email@example.com
LINKEDIN_PASSWORD=your_secure_password

# 4. Browser & Runtime Settings
HEADLESS=False
MAX_APPLICATIONS=30

# 5. Applicant Profile Defaults
APPLICANT_NAME=Your Full Name
APPLICANT_PHONE=1234567890
JOB_KEYWORD=Python Developer
JOB_LOCATION=Chennai
RESUME_PATH=
